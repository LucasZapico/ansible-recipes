#!/usr/bin/env bash
# MANAGED BY ANSIBLE (roles/db_backup) — do not edit on the host.
#
# Dumps each configured database, verifies the dump is real (not just a valid
# gzip of nothing), prunes old local copies, and — if offsite is enabled —
# pushes verified dumps to the offsite host and prunes old copies there. A
# failed dump or a failed verification is a non-zero exit, so the systemd unit
# records it and `systemctl --failed` / the timer status surfaces it, rather
# than the failure hiding inside a pipe.
set -euo pipefail

LOCAL_DIR="{{ db_backup_dir }}"
RETENTION_DAYS="{{ db_backup_retention_days }}"
TS="$(date +%Y%m%d_%H%M%S)"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
fail() { log "ERROR: $*"; exit 1; }

mkdir -p "$LOCAL_DIR"

# A dump is trusted only if it gunzips cleanly AND contains real content:
# for postgres a CREATE TABLE, for mongo a non-trivial byte count. An empty
# but valid gzip (the failure mode of the old script) is rejected here.
verify_postgres() {  # $1 = file
  gzip -t "$1" || return 1
  [ "$(zcat "$1" | grep -c '^CREATE TABLE')" -gt 0 ] || return 1
}
verify_mongo() {  # $1 = file  (mongodump archive; just needs to be a real, non-tiny gzip)
  gzip -t "$1" || return 1
  [ "$(stat -c %s "$1")" -gt 10240 ] || return 1
}

declare -a FRESH=()
{% for d in db_backup_databases %}
# ---- {{ d.name }} ({{ d.engine }}, container {{ d.container }}) ----
F="$LOCAL_DIR/{{ d.name }}_{{ d.engine }}_${TS}.{{ 'sql.gz' if d.engine == 'postgres' else 'archive.gz' }}"
log "dumping {{ d.name }} -> $F"
# Resolve the running container by an anchored name regex, never a fixed name.
# Coolify ignores a compose `container_name:` and appends a per-deploy suffix
# (bhreco-postgres-staging-<resourceuuid>-<epoch>), so the exact name changes on
# every redeploy. The match MUST resolve to exactly one container; zero or many
# is a hard failure, so a bad pattern can never silently dump the wrong database
# (the failure mode of the sync job this role replaces).
CID="$(docker ps -q --filter "name={{ d.container }}")"
CN="$(printf '%s\n' "$CID" | grep -c .)"
[ "$CN" -eq 1 ] || fail "{{ d.name }}: expected exactly 1 running container matching /{{ d.container }}/, found $CN"
{% if d.engine == 'postgres' %}
docker exec "$CID" pg_dump -U {{ d.user }} {{ d.db }} | gzip > "$F"
verify_postgres "$F" || fail "{{ d.name }}: dump failed verification (empty or corrupt)"
{% elif d.engine == 'mongo' %}
docker exec "$CID" mongodump --username {{ d.user }} --password '{{ d.password }}' \
  --authenticationDatabase admin --db {{ d.db }} --archive | gzip > "$F"
verify_mongo "$F" || fail "{{ d.name }}: dump failed verification (empty or corrupt)"
{% endif %}
log "{{ d.name }}: ok, $(du -h "$F" | cut -f1)"
FRESH+=("$F")
{% endfor %}

# Prune local copies older than the retention window.
find "$LOCAL_DIR" -maxdepth 1 -name '*.gz' -mtime +"$RETENTION_DAYS" -delete
log "local prune done (>${RETENTION_DAYS}d)"

{% if db_backup_offsite_enabled %}
# ---- offsite copy to {{ db_backup_offsite_host }} ----
SSH="ssh -i {{ db_backup_ssh_key }} -o BatchMode=yes -o ConnectTimeout=15"
REMOTE="{{ db_backup_offsite_user }}@{{ db_backup_offsite_host }}"
RDIR="{{ db_backup_offsite_dir }}"
$SSH "$REMOTE" "mkdir -p '$RDIR'" || fail "offsite: cannot reach $REMOTE"
for f in "${FRESH[@]}"; do
  rsync -a -e "$SSH" "$f" "$REMOTE:$RDIR/" || fail "offsite: rsync of $f failed"
  # Confirm the remote copy is the same size, not just that rsync exited 0.
  L=$(stat -c %s "$f"); R=$($SSH "$REMOTE" "stat -c %s '$RDIR/$(basename "$f")'" 2>/dev/null || echo 0)
  [ "$L" = "$R" ] || fail "offsite: size mismatch for $(basename "$f") (local $L, remote $R)"
done
# Prune offsite by its own (longer) retention.
$SSH "$REMOTE" "find '$RDIR' -maxdepth 1 -name '*.gz' -mtime +{{ db_backup_offsite_retention_days }} -delete" || true
log "offsite copy verified to $REMOTE:$RDIR"
{% endif %}

log "backup run complete"
