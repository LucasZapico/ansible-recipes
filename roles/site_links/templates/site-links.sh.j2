#!/usr/bin/env bash
# Weekly broken-link check, one site after another (managed by ansible role
# site_links). Each site reports to its own ntfy topic, every run, found
# something or not. Dead links are the report's news, not the job's failure:
# the checker exits 1 for them and the job still succeeds. The job fails only
# when a site could not be checked or its report could not be sent (exit 2),
# which is what `systemctl --failed` should show.
set -u
status=0
{% for site in site_links_sites %}
(
  set -a
  # shellcheck disable=SC1091
  . /etc/site-links/{{ site.name }}.env
  set +a
  exec node {{ site_links_script_dir }}/check-links.mjs \
    --name='{{ site.name }}' \
    --base='{{ site.base_url }}' \
    --sitemap='{{ site.sitemap | default("/sitemap.xml") }}' \
    --canonical='{{ site.canonical | default([]) | join(",") }}' \
    --out='{{ site_links_state_dir }}/{{ site.name }}' \
    --keep='{{ site_links_keep }}' \
    --notify
)
rc=$?
echo "site-links: {{ site.name }} finished with exit ${rc}"
[ "$rc" -ne 0 ] && [ "$rc" -ne 1 ] && status=1
{% if site.places is defined %}
(
  set -a
  # shellcheck disable=SC1091
  . /etc/site-links/{{ site.name }}.env
  set +a
  exec node {{ site_links_script_dir }}/check-places.mjs \
    --name='{{ site.name }}' \
    --source='{{ site.places.source }}' \
    --near='{{ site.places.near | default("") }}' \
    --out='{{ site_links_state_dir }}/{{ site.name }}' \
    --keep='{{ site_links_keep }}' \
    --notify
)
rc=$?
echo "site-links: {{ site.name }} places finished with exit ${rc}"
[ "$rc" -ne 0 ] && [ "$rc" -ne 1 ] && status=1
{% endif %}
{% endfor %}
exit "$status"
